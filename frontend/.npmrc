# React 19 ada di proyek ini, beberapa library upstream (mis. recharts 2.12.7)
# masih punya peer dep React 16-18 di metadata-nya walaupun runtime-nya
# kompatibel. Flag ini meminta npm untuk skip validasi peer dep yang strict.
#
# Dampak: npm install akan tetap berjalan walau ada warning peer dep.
# Tambahkan komentar di sini saat upgrade — sekali semua paket mendukung
# React 19 secara native, file ini bisa dihapus.
legacy-peer-deps=true
