# AGROWTH Frontend — example environment configuration.
# Salin file ini menjadi `.env.local` dan sesuaikan.
# Variabel ber-prefix `NEXT_PUBLIC_` akan di-expose ke browser.

# -----------------------------------------------------------------------------
# Backend API
# -----------------------------------------------------------------------------
# Base URL backend FastAPI (tanpa trailing slash).
NEXT_PUBLIC_API_URL="http://localhost:8000"

# -----------------------------------------------------------------------------
# Mapbox GL
# -----------------------------------------------------------------------------
# Public access token Mapbox (gratis di https://account.mapbox.com/access-tokens/).
# Component peta akan throw jika kosong, jadi WAJIB di-isi untuk dev.
# Disarankan apply URL restrictions ke domain dev/prod kamu.
NEXT_PUBLIC_MAPBOX_TOKEN=""
