# AGROWTH Backend — example environment configuration.
# Salin file ini menjadi `.env` di direktori `backend/` dan isi sesuai kebutuhan.
# Semua variabel di bawah opsional kecuali ditandai (REQUIRED untuk produksi).

# -----------------------------------------------------------------------------
# App identity
# -----------------------------------------------------------------------------
APP_NAME="AGROWTH API"
APP_VERSION="0.1.0"
# development | staging | production
APP_ENVIRONMENT="development"

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Daftar origin yang diizinkan, pisahkan dengan koma (tanpa spasi setelah koma).
# Default sudah include localhost:3000 (Next.js), :5173 (Vite), :8080 (alt).
# Override contoh: hanya production frontend
# CORS_ORIGINS="https://agrowth.example.com,https://www.agrowth.example.com"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8080"

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL="INFO"

# -----------------------------------------------------------------------------
# Gemini LLM (Google AI Studio)
# -----------------------------------------------------------------------------
# Ambil API key gratis di https://aistudio.google.com/app/apikey
# Tanpa key, sistem otomatis pakai fallback statis berbasis Pranata Mangsa.
GEMINI_API_KEY=""

# Nama model Gemini. Default versi terbaru.
GEMINI_MODEL="gemini-2.5-flash"

# Suhu sampling LLM (0.0 deterministik .. 2.0 sangat kreatif).
GEMINI_TEMPERATURE="0.7"

# TTL cache rekomendasi LLM dalam detik.
GEMINI_CACHE_TTL_SEC="300"

# Timeout panggilan API Gemini dalam detik.
GEMINI_TIMEOUT_SEC="20.0"
